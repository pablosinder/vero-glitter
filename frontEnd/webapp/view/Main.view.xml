<mvc:View
	controllerName="org.myui5app.controller.Main"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	core:require="{
		formatter: 'org/myui5app/model/formatter'
	}">

	<Page
		title="{i18n>appTitle}"
		id="page">
		<content>
			<Table id="idProductsTable"
			inset="false"
			items="{MainModel>/items}">
			<columns>
				<Column
					width="12em">
					<Text text="Name" />
				</Column>
				<Column
					minScreenWidth="Tablet"
					demandPopin="true">
					<Text text="Upvote" />
				</Column>
				<Column
					hAlign="End">
				</Column>
			</columns>
			<items>
				<ColumnListItem vAlign="Middle">
					<cells>
						<Text
							text="{MainModel>name}" />
						<Text
							text="{MainModel>upvotes}" />
						<Button icon="sap-icon://thumb-up" press="onUpvotePress"/>
					</cells>
				</ColumnListItem>
			</items>
		</Table>
		</content>
	</Page>

</mvc:View>
